{
  "name": "car-wash-miniapp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node --test dist/tests/*.test.js",
    "test:integration": "npm run build --silent && node --test dist/tests/*.integration.js",
    "migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
